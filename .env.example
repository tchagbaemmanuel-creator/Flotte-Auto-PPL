# Copier en .env (ne pas committer .env)

PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_string_here

# MongoDB Atlas (obligatoire en production sur Render pour ne pas perdre les données)
# Encoder le mot de passe seul si caractères spéciaux : node -e "console.log(encodeURIComponent('votre_mdp'))"
# MONGODB_URI=mongodb+srv://USER:PASSWORD_ENCODE@cluster0.xxxxx.mongodb.net/flotte_ppl?retryWrites=true&w=majority&appName=Cluster0
# MONGODB_DB_NAME=flotte_ppl
