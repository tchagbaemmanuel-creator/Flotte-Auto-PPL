# Copier en .env (ne pas committer .env)

PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_string_here

# MongoDB Atlas — option A (recommandé sur Render) : 3 variables, mot de passe en clair OK
# MONGODB_USER=tchagbaemmanuel_db_user
# MONGODB_PASSWORD=votre_mot_de_passe_atlas
# MONGODB_HOST=cluster0.xxxxx.mongodb.net
# MONGODB_DB_NAME=flotte_ppl

# Option B : une seule chaîne (mot de passe avec @ < > doit être encodé à la main)
# MONGODB_URI=mongodb+srv://USER:PASSWORD_ENCODE@cluster0.xxxxx.mongodb.net/flotte_ppl?retryWrites=true&w=majority

# Architecture persistance (automatique si Mongo connecté) :
# - kv_store : une entrée par clé métier (p5_v, p5_d, …) — pas de limite 16 Mo par document
# - media (GridFS) : photos / scans > ~40 Ko — volume selon votre offre Atlas
# - users : un document par compte (sync avec p5_ac)
# Migration auto depuis l’ancienne collection app_state au premier démarrage.
